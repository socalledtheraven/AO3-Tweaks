{
	"name": "AO3 Tweaks",
	"description": "An extension adding various little tweaks to Ao3.",
	"version": "4.4.0",
	"manifest_version": 3,
	"permissions": ["storage"],
	"content_scripts": [
		{
			"js": ["scripts/loader.js"],
			"matches": ["*://archiveofourown.org/*"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"scripts/utilities.js",
				"scripts/latestChapter.js",
				"scripts/saveAsToRead.js",
				"scripts/bookmarkNotes.js",
				"scripts/rekudos.js",
				"scripts/comments.js"
			],
			"matches": ["*://archiveofourown.org/*"]
		}
	],
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png",
		"96": "images/icon128.png"
	},
	"options_ui": {
		"page": "options.html"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{ad53cfca-a2b3-4d9f-95ae-adcf2fa65479}",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}